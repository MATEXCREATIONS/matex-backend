# ==================== SERVER CONFIGURATION ====================
PORT=5001
NODE_ENV=production

# ==================== PAYSTACK PAYMENT CONFIGURATION ====================
# Get these from your Paystack dashboard: https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY_HERE

# ==================== SUPABASE DATABASE CONFIGURATION ====================
# Get these from your Supabase project settings: https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ==================== EMAIL CONFIGURATION (SMTP) ====================
# For Gmail, generate an app password: https://myaccount.google.com/apppasswords
# See SETUP_GUIDE.md for detailed Gmail setup instructions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password

# ==================== EMAIL RECIPIENTS ====================
# Used for notifications and order communications
DESIGNER_EMAIL=designer@matexcreations.com
NOREPLY_EMAIL=noreply@matexcreations.com

# ==================== ADMIN AUTHENTICATION ====================
# Change these to secure random values in production
# Admin password is used to login to the admin dashboard
# Admin secret key is used to sign admin authentication tokens
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE
ADMIN_SECRET_KEY=YOUR_SECURE_SECRET_KEY_HERE
ADMIN_TOKEN_TTL_MS=1800000

# ==================== OPTIONAL: E2E TESTING ====================
# Only needed if running end-to-end tests
# E2E_BASE=https://api.matexcreations.com
